POSTGRES_DB=story_game
POSTGRES_USER=story_game
POSTGRES_PASSWORD=story_game_dev
POSTGRES_HOST_PORT=5433
STORY_GAME_POSTGRES_DSN=postgresql://story_game:story_game_dev@localhost:5433/story_game
STORY_GAME_LMSTUDIO_BASE_URL=http://localhost:1234/v1
STORY_GAME_LMSTUDIO_MODEL_ID=
STORY_GAME_LMSTUDIO_API_TOKEN=
STORY_GAME_LMSTUDIO_TIMEOUT_SECONDS=60
KEYCLOAK_HOST_PORT=8081
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev
STORY_GAME_KEYCLOAK_ISSUER=http://auth.storygame.localhost/realms/story-game
STORY_GAME_KEYCLOAK_AUDIENCE=story-game-frontend
# Only needed when the backend itself runs inside the Docker network (see
# compose.yaml and docs/human/operations/keycloak.md) — a host-native run
# reaches auth.storygame.localhost directly, same as the issuer above.
# STORY_GAME_KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/story-game/protocol/openid-connect/certs
