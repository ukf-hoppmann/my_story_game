# Vorlage für provider-spezifische API-Keys.
#
# Kopiere diese Datei zu `llm.secrets.toml` (im selben Verzeichnis) und trage
# dort die echten Keys ein. `llm.secrets.toml` ist in .gitignore eingetragen
# und wird nie versioniert — im Unterschied zu `llm.toml`, das den geteilten,
# versionierten Modell-Katalog beschreibt und niemals Secrets enthalten darf.
#
# Nur Provider, die tatsächlich einen Key brauchen, müssen hier stehen.
# LM Studio (lokal) braucht normalerweise keinen.

[providers.groq]
api_key = "gsk_dein_key_hier"

[providers.gemini]
api_key = "dein_google_ai_studio_key_hier"
