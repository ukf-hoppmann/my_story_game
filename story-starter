#!/usr/bin/env bash

set -Eeuo pipefail

script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
compose_file="${script_directory}/compose.yaml"
api_port="${API_HOST_PORT:-8000}"

print_help() {
  cat <<EOF
Verwendung: $(basename -- "${BASH_SOURCE[0]}") [-h|--help]

Startet Story Game (PostgreSQL und API) über Docker Compose.

Optionen:
  -h, --help    Diese Hilfe anzeigen und beenden

Umgebungsvariablen:
  API_HOST_PORT  Host-Port für die API (Standard: 8000)

Compose-Datei: ${compose_file}
EOF
}

case "${1:-}" in
  -h|--help)
    print_help
    exit 0
    ;;
esac

if ! command -v docker >/dev/null 2>&1; then
  echo "Fehler: Docker wurde nicht gefunden." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "Fehler: Docker Compose ist nicht verfügbar." >&2
  exit 1
fi

if [[ ! -f "${compose_file}" ]]; then
  echo "Fehler: Compose-Datei fehlt: ${compose_file}" >&2
  exit 1
fi

echo "Starte Story Game mit PostgreSQL und API ..."
docker compose --file "${compose_file}" up \
  --build \
  --detach \
  --wait \
  postgres api

cat <<EOF

Story Game läuft:
  API:        http://localhost:${api_port}
  Swagger UI: http://localhost:${api_port}/docs
  OpenAPI:    http://localhost:${api_port}/openapi.json
  ReDoc:      http://localhost:${api_port}/redoc

Zum Stoppen: docker compose --file "${compose_file}" down
EOF
